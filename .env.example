# Spotify app credentials: https://developer.spotify.com/dashboard
# Note: Spotify requires the app owner's account to have an active Premium subscription.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must also be added as a Redirect URI in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback

# Last.fm API key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
